{
  "version": 6,
  "configurePresets": [
    {
      "name": "llvm_base",
      "displayName": "Base LLVM config.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CODE_COVERAGE": "OFF",
        "LINT": "OFF",
        "WARNINGS": "ON"
      }
    },
    {
      "name": "llvm_debug",
      "displayName": "Debug LLVM config.",
      "inherits": ["llvm_base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fstack-protector-strong -fwrapv"
      }
    },
    {
      "name": "llvm_release",
      "displayName": "Release LLVM config.",
      "inherits": ["llvm_base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "llvm_debug_san",
      "displayName": "Debug LLVM ub, asan and code coverage config.",
      "inherits": ["llvm_base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fstack-protector-strong -fwrapv",
        "CODE_COVERAGE": "ON",
        "LINT": "ON"
      }
    },
    {
      "name": "llvm_debug_valgrind",
      "displayName": "Debug LLVM valgrind config.",
      "inherits": ["llvm_base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TEST_LAUNCHER": "valgrind;--error-exitcode=1;--leak-check=full"
      }
    },
    {
      "name": "llvm_release_tsan",
      "displayName": "Release LLVM tsan config.",
      "inherits": ["llvm_base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread"
      }
    }
  ]
}
